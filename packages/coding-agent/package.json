{
  "name": "@dst0/p",
  "version": "5.0.2",
  "description": "Coding agent CLI with read, bash, edit, write tools and session management",
  "type": "module",
  "bin": {
    "p": "dist/cli.js",
    "p-voice": "dist/voice-server-cli.js"
  },
  "piConfig": {
    "name": "p",
    "configDir": ".p"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "containerization.md",
    "CHANGELOG.md",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "clean": "node ../../scripts/workspace-file-operations.js clean",
    "build": "tsgo -p tsconfig.build.json && node ../../scripts/workspace-file-operations.js chmod-cli && npm run copy-assets && node ../../scripts/build-indexing-tray.js",
    "build:binary": "npm --prefix ../tui run build && npm --prefix ../ai run build && npm --prefix ../agent run build && npm run build && bun build --compile ./dist/bun/cli.js ./src/utils/image-resize-worker.ts --outfile dist/pi && npm run copy-binary-assets",
    "copy-assets": "node ../../scripts/workspace-file-operations.js copy-assets",
    "copy-binary-assets": "node ../../scripts/workspace-file-operations.js copy-binary-assets",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "shrinkwrap": "node ../../scripts/generate-coding-agent-shrinkwrap.js",
    "prepublishOnly": "npm run clean && npm run build && npm run shrinkwrap"
  },
  "dependencies": {
    "@dst0/p-agent-core": "^5.0.2",
    "@dst0/p-ai": "^5.0.2",
    "@dst0/p-code-index": "^5.0.2",
    "@dst0/p-tui": "^5.0.2",
    "@silvia-odwyer/photon-node": "0.3.4",
    "chalk": "5.6.2",
    "cross-spawn": "7.0.6",
    "diff": "8.0.4",
    "glob": "13.0.6",
    "highlight.js": "10.7.3",
    "hosted-git-info": "9.0.3",
    "ignore": "7.0.5",
    "jiti": "2.7.0",
    "minimatch": "10.2.5",
    "proper-lockfile": "4.1.2",
    "semver": "7.8.0",
    "typebox": "1.1.38",
    "undici": "8.11.2",
    "yaml": "2.9.0"
  },
  "overrides": {
    "rimraf": "6.1.2",
    "gaxios": {
      "rimraf": "6.1.2"
    }
  },
  "optionalDependencies": {
    "@mariozechner/clipboard": "0.3.9"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/diff": "7.0.2",
    "@types/hosted-git-info": "3.0.5",
    "@types/ms": "2.1.0",
    "@types/node": "24.12.4",
    "@types/proper-lockfile": "4.1.4",
    "@types/semver": "7.7.1",
    "typescript": "5.9.3",
    "@vitest/coverage-v8": "4.1.11",
    "vitest": "4.1.11"
  },
  "keywords": [
    "coding-agent",
    "ai",
    "llm",
    "cli",
    "tui",
    "agent"
  ],
  "author": "dst",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dst0/p.git",
    "directory": "packages/coding-agent"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
